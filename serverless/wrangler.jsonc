{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pidp-serverless",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-03",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "PIdP",
    "ENV": "dev",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "60",
    "ALLOWED_ORIGINS": "",
    "ADMIN_EMAILS": "",
    "ADMIN_USER_IDS": "",
    "PUBLIC_R2_BASE_URL": "",
    "FRONTEND_REDIRECT_URL": "",
    "GOOGLE_REDIRECT_URI": "",
    "GITHUB_REDIRECT_URI": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pidp",
      "database_id": "replace-with-cloudflare-d1-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "pidp-avatars"
    }
  ]
}
