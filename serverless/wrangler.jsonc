{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pidp-codecollective",
  "main": "src/index.ts",
  "build": {
    "command": "npm run build:metadata"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-06-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "id.orgportal.cc",
      "custom_domain": true
    }
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "redact_query_string": true,
    "enabled": true
  },
  "vars": {
    "APP_NAME": "OrgPortal",
    "MCP_OAUTH_RESOURCE_CONFIG_JSON": "{\"https://orgportal.cc/mcp\":{\"secretHash\":\"cf5146c0d9d32987d59204ddd8c4082c1ae7605c3e9b5d0b89d53ab0ab15e2bd\",\"portal\":{\"name\":\"OrgPortal\",\"loginUrl\":\"https://orgportal.cc/users/mcp-connect\"}},\"https://compai.lifetech.fyi/api/swarm\":{\"secretHash\":\"d46341d871823f4c9be698d265da1c758c4061cd6e0365a3a64aaba3081f89b5\",\"scopes\":[\"swarm:control\"]}}",
    "ENV": "production",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "60",
    "ALLOWED_ORIGINS": "https://codecollective.us,https://www.codecollective.us",
    "PORTAL_AUTH_ORIGINS": "https://portal.deism.church,https://medtech.social,https://lifetech.fyi,https://codecollective.us,https://www.codecollective.us,https://timebank.codecollective.us,https://bmoretimebank.codecollective.us,https://orgportal.cc",
    "PORTAL_SSO_APP_SLUG": "orgportal",
    "PORTAL_SHARED_IDENTITY": "false",
    "ADMIN_EMAILS": "",
    "ADMIN_USER_IDS": "46d3aec0-d4f4-46fc-860e-3fb7a82702ba",
    "SESSION_COOKIE_DOMAIN": "",
    "PUBLIC_R2_BASE_URL": "",
    "PUBLIC_BASE_URL": "https://orgportal.cc/pidp",
    "FRONTEND_REDIRECT_URL": "https://orgportal.cc/communities",
    "NATIVE_REDIRECT_SCHEMES": "org.arkavo.portal,codecollective",
    "GOOGLE_REDIRECT_URI": "https://orgportal.cc/pidp/auth/google/callback",
    "GOOGLE_CALENDAR_REDIRECT_URI": "",
    "MICROSOFT_REDIRECT_URI": "",
    "MICROSOFT_CALENDAR_REDIRECT_URI": "",
    "GITHUB_REDIRECT_URI": "https://orgportal.cc/pidp/auth/github/callback",
    "EMAIL_FROM": "verification@notify.orgportal.cc",
    "EMAIL_VERIFICATION_REQUIRED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pidp",
      "database_id": "582fc740-4275-482a-bec0-a161a0aa6623"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "pidp-avatars"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "verification@notify.orgportal.cc"
      ]
    }
  ]
}
