{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pidp-codecollective",
  "main": "src/index.ts",
  "build": {
    "command": "npm run build:metadata"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "compatibility_date": "2026-06-03",
  "workers_dev": true,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": {
    "redact_query_string": true,
    "enabled": true
  },
  "vars": {
    "APP_NAME": "PIdP",
    "MCP_OAUTH_RESOURCE_CONFIG_JSON": "{\"https://orgportal.cc/api/org/mcp\": {\"secretHash\": \"cf5146c0d9d32987d59204ddd8c4082c1ae7605c3e9b5d0b89d53ab0ab15e2bd\", \"portal\": {\"name\": \"OrgPortal\", \"loginUrl\": \"https://orgportal.cc/users/mcp-connect\"}}}",
    "ENV": "dev",
    "ACCESS_TOKEN_EXPIRE_MINUTES": "525600",
    "ALLOWED_ORIGINS": "",
    "PORTAL_AUTH_ORIGINS": "https://medtech.social,https://lifetech.fyi,https://codecollective.us,https://www.codecollective.us,https://timebank.codecollective.us,https://bmoretimebank.codecollective.us,https://orgportal.cc",
    "PORTAL_SSO_APP_SLUG": "code-collective",
    "ADMIN_EMAILS": "",
    "ADMIN_USER_IDS": "46d3aec0-d4f4-46fc-860e-3fb7a82702ba",
    "SESSION_COOKIE_DOMAIN": "codecollective.us",
    "PUBLIC_R2_BASE_URL": "",
    "PUBLIC_BASE_URL": "https://id.codecollective.us",
    "FRONTEND_REDIRECT_URL": "",
    "NATIVE_REDIRECT_SCHEMES": "org.arkavo.portal,codecollective",
    "GOOGLE_REDIRECT_URI": "",
    "GOOGLE_CALENDAR_REDIRECT_URI": "",
    "MICROSOFT_REDIRECT_URI": "",
    "MICROSOFT_CALENDAR_REDIRECT_URI": "",
    "GITHUB_REDIRECT_URI": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pidp",
      "database_id": "582fc740-4275-482a-bec0-a161a0aa6623"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "pidp-avatars"
    }
  ],
  "limits": {
    "cpu_ms": 1000
  }
}
