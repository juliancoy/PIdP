{
  "name": "pidp-serverless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:metadata": "node scripts/build-metadata.mjs",
    "pretypecheck": "npm run build:metadata",
    "pretest": "npm run build:metadata",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:metadata",
    "deploy:serverless": "node scripts/deploy.mjs",
    "deploy:status": "node scripts/deploy.mjs --check-only",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test",
    "db:migrate:local": "wrangler d1 migrations apply pidp --local",
    "db:migrate:remote": "wrangler d1 migrations apply pidp --remote"
  },
  "dependencies": {
    "hono": "^4.8.0",
    "jose": "^6.2.12",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.98.0"
  }
}
