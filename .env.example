# Cloudflare deployment token used by serverless/scripts/deploy.mjs.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token

# Shared Worker auth secret.
SECRET_KEY=replace-with-long-random-secret

# OAuth callback URLs must match the URLs configured in each provider console.
FRONTEND_REDIRECT_URL=https://replace-with-frontend-host/auth/callback
GOOGLE_REDIRECT_URI=https://replace-with-worker-host/auth/google/callback
GITHUB_REDIRECT_URI=https://replace-with-worker-host/auth/github/callback

# Google OAuth app credentials.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# GitHub OAuth app credentials.
GITHUB_CLIENT_ID=replace-with-github-client-id
GITHUB_CLIENT_SECRET=replace-with-github-client-secret

R2_ACCOUNT_ID=xxxxxxxx
R2_DEFAULT_BUCKET=xxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_PARENT_ACCESS_KEY_ID=xxxxxxxx
R2_SIGNED_URL_TTL_SECONDS=xxxxxxxx
